; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Codeplay in Kart"
config/description="Jogo de kart arcade open-source com karts customizáveis."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://assets/ui/app_icon.ico"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Settings="*res://scripts/autoload/settings.gd"
Music="*res://scripts/autoload/music.gd"
MenuNav="*res://scripts/autoload/menu_nav.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
common/physics_ticks_per_second.mobile=60
common/max_physics_steps_per_frame.mobile=5

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
