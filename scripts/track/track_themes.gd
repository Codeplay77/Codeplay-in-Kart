static func resolve(theme_id: String, overrides := {}) -> Dictionary:
	var t := BASE.duplicate(true)
	t.merge(THEMES.get(theme_id, THEMES.valley), true)
	t.merge(overrides, true)
	t["id"] = theme_id
	return t
